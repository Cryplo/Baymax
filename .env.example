# Baymax Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Composio API Key
# =============================================================================
# Get your key at: https://app.composio.dev
COMPOSIO_API_KEY=your_composio_api_key_here

# =============================================================================
# REQUIRED: Azure OpenAI Configuration (for Anthropic models via Azure Foundry)
# =============================================================================
# Your Azure OpenAI endpoint (e.g., https://your-resource.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Your Azure OpenAI API key
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

# API version (default: 2024-10-21)
AZURE_OPENAI_API_VERSION=2024-10-21

# Deployment name for the model (default: claude-3-5-haiku)
# This should match your Azure deployment name for the Anthropic model
AZURE_DEPLOYMENT_NAME=claude-3-5-haiku
