# Baymax Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Anthropic Configuration (Choose ONE option)
# =============================================================================

# Option 1: Direct Anthropic API
# Get your API key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Option 2: Azure AI Foundry
# Uncomment and fill in these lines to use Azure AI Foundry:
# USE_FOUNDRY=1
# ANTHROPIC_FOUNDRY_API_KEY=your_foundry_api_key
# ANTHROPIC_FOUNDRY_RESOURCE=your-resource-name
# (Resource name is the part before .services.ai.azure.com in your endpoint URL)

# Model name (default: claude-sonnet-4-5-20250929)
MODEL_NAME=claude-sonnet-4-5-20250929

# =============================================================================
# REQUIRED: Composio Configuration
# =============================================================================
# Get your API key at: https://app.composio.dev
COMPOSIO_API_KEY=

# Optional: Your Composio user ID (auto-detected if not set)
# COMPOSIO_USER_ID=
