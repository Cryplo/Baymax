# Baymax Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Composio Configuration
# =============================================================================
# Get your API key at: https://app.composio.dev
COMPOSIO_API_KEY=

# Optional: Your Composio user ID (auto-detected if not set)
# COMPOSIO_USER_ID=

# =============================================================================
# REQUIRED: LLM Configuration
# =============================================================================
# Your LLM API endpoint
TARGET_URL=

# Your LLM API key
API_KEY=

# Model name (default: claude-sonnet-4-5)
MODEL_NAME=claude-sonnet-4-5