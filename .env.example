# Baymax Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Authentication (Choose ONE option)
# =============================================================================

# Option 1: Direct Anthropic API
# Get your API key at: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Option 2: Azure AI Foundry
# Set this to "1" to use Azure AI Foundry
# CLAUDE_CODE_USE_FOUNDRY=1
# ANTHROPIC_FOUNDRY_RESOURCE=your-resource-name
# (Configure Azure credentials via `az login` or environment variables)

# Option 3: AWS Bedrock
# CLAUDE_CODE_USE_BEDROCK=1
# (Configure AWS credentials)

# Option 4: Google Vertex AI
# CLAUDE_CODE_USE_VERTEX=1
# (Configure Google Cloud credentials)

# =============================================================================
# Model Configuration
# =============================================================================
# Model to use: sonnet, opus, haiku
MODEL_NAME=sonnet

# =============================================================================
# Composio Integration (Optional)
# =============================================================================
# Composio provides access to external services like Gmail, Google Calendar,
# Slack, GitHub, Notion, Discord, LinkedIn, and more.
#
# 1. Sign up at: https://composio.dev
# 2. Get your API key from the dashboard
# 3. Connect your apps at: https://app.composio.dev/apps
#
COMPOSIO_API_KEY=
